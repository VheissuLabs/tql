# Maintainer: VheissuLabs <karl@notarydash.com>
pkgname=tql-bin
pkgver=VERSION
pkgrel=1
pkgdesc="A database client for the terminal"
arch=('x86_64' 'aarch64')
url="https://github.com/VheissuLabs/tql"
license=('MIT')
depends=()
options=('!strip' '!debug')
provides=('tql')
conflicts=('tql')
source_x86_64=("tql-$pkgver-x86_64::$url/releases/download/v$pkgver/tql-linux-x86_64")
source_aarch64=("tql-$pkgver-aarch64::$url/releases/download/v$pkgver/tql-linux-aarch64")
sha256sums_x86_64=('SHA_LINUX_INTEL')
sha256sums_aarch64=('SHA_LINUX_ARM')

package() {
    install -Dm755 "$srcdir/tql-$pkgver-$CARCH" "$pkgdir/usr/bin/tql"
}
