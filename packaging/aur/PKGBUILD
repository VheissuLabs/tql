# Maintainer: VheissuLabs <karl@notarydash.com>
# pkgver and sha256sums are filled in by the release workflow.
pkgname=tql-bin
pkgver=VERSION
pkgrel=1
pkgdesc="A database client for the terminal"
arch=('any')
url="https://github.com/VheissuLabs/tql"
license=('MIT')
depends=('php>=8.4')
provides=('tql')
conflicts=('tql')
source=("tql-$pkgver::https://github.com/VheissuLabs/tql/releases/download/v$pkgver/tql")
sha256sums=('SHA')

package() {
    install -Dm755 "$srcdir/tql-$pkgver" "$pkgdir/usr/bin/tql"
}
